    <script>
        // --- 1. 상태 관리 및 로컬 스토리지 ---
        const STORAGE_KEY = 'odung_teacher_picker_v2';
        let students = []; // { id, name, absent: boolean, picked: boolean }
        let drawCount = 1;
        let isAnimating = false;
        let soundEnabled = true;
        let currentTab = 'claw';

        function initApp() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                try {
                    const parsed = JSON.parse(saved);
                    if (Array.isArray(parsed) && parsed.length > 0) {
                        students = parsed;
                    }
                } catch (e) {
                    console.error('명단 로드 오류:', e);
                }
            }
            if (students.length === 0) {
                students = Array.from({ length: 25 }, (_, i) => ({
                    id: 'stu_' + (i + 1),
                    name: `${i + 1}번`,
                    absent: false,
                    picked: false
                }));
                saveState();
            }

            syncRosterTextarea();
            renderAttendanceGrid();
            updateStatusUI();
        }

        function saveState() {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(students));
        }

        // 탭 전환 (번호 뽑기 <-> 모둠 편성)
        function switchMainTab(tabName) {
            if (isAnimating) {
                showToast('번호 뽑기가 진행 중일 때는 탭을 바꿀 수 없습니다!');
                return;
            }
            currentTab = tabName;

            const clawView = document.getElementById('view-claw');
            const groupView = document.getElementById('view-group');
            const clawBtn = document.getElementById('nav-tab-claw');
            const groupBtn = document.getElementById('nav-tab-group');

            if (tabName === 'claw') {
                clawView.classList.remove('hidden');
                groupView.classList.add('hidden');

                clawBtn.className = 'px-4 py-2 text-xs sm:text-sm font-bold border-2 border-[#4ade80] bg-[#4ade80] text-[#121629] shadow-[0_0_12px_rgba(74,222,128,0.4)] cursor-pointer transition-all';
                groupBtn.className = 'px-4 py-2 text-xs sm:text-sm font-bold border-2 border-[#3b3363] bg-[#1e193b] text-slate-300 hover:border-slate-400 hover:text-white cursor-pointer transition-all';
            } else {
                clawView.classList.add('hidden');
                groupView.classList.remove('hidden');

                groupBtn.className = 'px-4 py-2 text-xs sm:text-sm font-bold border-2 border-amber-400 bg-amber-400 text-[#121629] shadow-[0_0_12px_rgba(251,191,36,0.4)] cursor-pointer transition-all';
                clawBtn.className = 'px-4 py-2 text-xs sm:text-sm font-bold border-2 border-[#3b3363] bg-[#1e193b] text-slate-300 hover:border-slate-400 hover:text-white cursor-pointer transition-all';
            }
        }

        // --- 2. 8비트 레트로 효과음 (Web Audio API) ---
        let audioCtx = null;
        function playTone(freq, type = 'square', duration = 0.1, delay = 0, vol = 0.08) {
            if (!soundEnabled) return;
            try {
                if (!audioCtx) {
                    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                }
                if (audioCtx.state === 'suspended') audioCtx.resume();

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime + delay);

                gain.gain.setValueAtTime(vol, audioCtx.currentTime + delay);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + delay + duration);

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                osc.start(audioCtx.currentTime + delay);
                osc.stop(audioCtx.currentTime + delay + duration);
            } catch (e) {}
        }

        function sfxMove() {
            playTone(320, 'square', 0.07, 0, 0.05);
            playTone(400, 'square', 0.07, 0.08, 0.05);
        }

        function sfxDrop() {
            playTone(500, 'triangle', 0.1, 0, 0.08);
            playTone(380, 'triangle', 0.1, 0.1, 0.08);
            playTone(260, 'triangle', 0.12, 0.2, 0.08);
        }

        function sfxCatch() {
            playTone(523.25, 'square', 0.08, 0, 0.07);
            playTone(659.25, 'square', 0.08, 0.08, 0.07);
            playTone(783.99, 'square', 0.14, 0.16, 0.08);
        }

        function sfxFanfare() {
            const notes = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
            const times = [0, 0.1, 0.2, 0.3, 0.45, 0.58];
            notes.forEach((n, idx) => playTone(n, 'square', 0.15, times[idx], 0.09));
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const btn = document.getElementById('sound-toggle-btn');
            if (soundEnabled) {
                btn.textContent = '🔊 효과음 ON';
                btn.className = 'px-3 py-1.5 bg-[#121629] border-2 border-[#4ade80] text-[#4ade80] text-xs font-bold shadow-[0_0_10px_rgba(74,222,128,0.2)] cursor-pointer transition-all';
                playTone(660, 'square', 0.1, 0, 0.06);
            } else {
                btn.textContent = '🔇 효과음 OFF';
                btn.className = 'px-3 py-1.5 bg-[#121629] border-2 border-slate-500 text-slate-400 text-xs font-bold cursor-pointer transition-all';
            }
        }

        // --- 3. 인형뽑기 캡슐 렌더링 & 추첨 로직 ---
        const sleep = ms => new Promise(res => setTimeout(res, ms));

        // 1~50번 원문자 변환 유틸 함수 (①, ②, ③...)
        function getCircledNumber(num) {
            if (num >= 1 && num <= 20) return String.fromCharCode(0x2460 + num - 1);
            if (num >= 21 && num <= 35) return String.fromCharCode(0x3251 + num - 21);
            if (num >= 36 && num <= 50) return String.fromCharCode(0x32B1 + num - 36);
            return `(${num})`;
        }

        function setDrawCount(cnt) {
            if (isAnimating) return;
            let parsed = parseInt(cnt, 10);
            if (isNaN(parsed) || parsed < 1) parsed = 1;
            if (parsed > 50) parsed = 50;
            drawCount = parsed;

            document.getElementById('custom-draw-count').value = drawCount;
            document.getElementById('drop-counter-badge').textContent = `0 / ${drawCount}`;

            document.querySelectorAll('.draw-cnt-btn').forEach(btn => {
                const btnCnt = parseInt(btn.dataset.cnt, 10);
                if (btnCnt === drawCount) {
                    btn.className = 'draw-cnt-btn px-3 py-1.5 text-xs font-bold border-2 border-amber-400 bg-amber-400 text-[#121629] cursor-pointer';
                } else {
                    btn.className = 'draw-cnt-btn px-3 py-1.5 text-xs font-bold border-2 border-[#3b3363] bg-[#1e193b] text-slate-300 hover:border-slate-400 cursor-pointer';
                }
            });
        }

        function getEligibleStudents() {
            const noRepeat = document.getElementById('no-repeat-checkbox').checked;
            return students.filter(s => !s.absent && (!noRepeat || !s.picked));
        }

        // 첨부 이미지 스타일의 투명 캡슐 속 오둥이 인형 SVG 생성 함수
        function getOdungCapsuleSvg(showQuestion = false) {
            return `
                <svg viewBox="0 0 120 120" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <radialGradient id="odungSphere" cx="50%" cy="50%" r="50%">
                            <stop offset="68%" stop-color="#ffffff"/>
                            <stop offset="90%" stop-color="#d4d4d8"/>
                            <stop offset="100%" stop-color="#3f3f46"/>
                        </radialGradient>
                        <clipPath id="odungBodyClip">
                            <path d="M 27 89 C 22 55, 34 32, 61 32 C 88 32, 99 56, 95 89 C 92 103, 30 103, 27 89 Z" />
                        </clipPath>
                    </defs>
                    <!-- 캡슐 원형 배경 -->
                    <circle cx="60" cy="60" r="58" fill="url(#odungSphere)" stroke="#000" stroke-width="3" />
                    
                    <!-- 오둥이 노란 발 -->
                    <ellipse cx="44" cy="103" rx="11.5" ry="6" fill="#f59e0b" stroke="#000" stroke-width="4" />
                    <ellipse cx="77" cy="103" rx="11.5" ry="6" fill="#f59e0b" stroke="#000" stroke-width="4" />
                    
                    <!-- 오둥이 하얀 몸통 + 왼쪽 상단 회색 입체 음영 -->
                    <g clip-path="url(#odungBodyClip)">
                        <rect x="15" y="20" width="90" height="90" fill="#ffffff" />
                        <path d="M 22 58 C 24 38, 36 30, 52 30 C 40 34, 31 44, 29 60 Z" fill="#a1a1aa" />
                    </g>
                    <path d="M 27 89 C 22 55, 34 32, 61 32 C 88 32, 99 56, 95 89 C 92 103, 30 103, 27 89 Z" fill="none" stroke="#000000" stroke-width="4.5" stroke-linejoin="round" />
                    
                    <!-- 왼쪽 팔 -->
                    <path d="M 33 68 C 24 73, 24 89, 34 91" fill="#ffffff" stroke="#000000" stroke-width="4.2" stroke-linecap="round" />
                    <!-- 오른쪽 팔 -->
                    <path d="M 85 68 C 94 73, 94 89, 84 91" fill="#ffffff" stroke="#000000" stroke-width="4.2" stroke-linecap="round" />
                    
                    <!-- 나란히 붙은 두 눈 -->
                    <circle cx="51" cy="50" r="8.5" fill="#ffffff" stroke="#000000" stroke-width="3.8" />
                    <circle cx="51" cy="51" r="2.5" fill="#000000" />
                    <circle cx="67.5" cy="50" r="8.5" fill="#ffffff" stroke="#000000" stroke-width="3.8" />
                    <circle cx="67.5" cy="51" r="2.5" fill="#000000" />
                    
                    <!-- 주황색 긴 부리 -->
                    <path d="M 26 64 C 26 56, 75 56, 75 65 C 75 74, 26 74, 26 64 Z" fill="#FFA400" stroke="#000000" stroke-width="4" stroke-linejoin="round" />
                    
                    ${showQuestion ? `
                        <rect x="44" y="81" width="32" height="22" rx="5" fill="#fbbf24" stroke="#000" stroke-width="3" />
                        <text x="60" y="97" text-anchor="middle" font-size="15" font-weight="bold" fill="#000">?</text>
                    ` : ''}
                </svg>
            `;
        }

        function renderDollPile(count) {
            const container = document.getElementById('doll-pile-container');
            container.innerHTML = '';

            const displayCount = Math.min(count, 45);

            for (let i = 0; i < displayCount; i++) {
                const rot = ((i * 17) % 28) - 14;
                const delay = (i % 5) * 0.35;

                const ball = document.createElement('div');
                ball.className = 'doll-pile-item w-10 h-10 sm:w-11 sm:h-11 rounded-full border-2 border-black shadow-[2px_3px_4px_rgba(0,0,0,0.75)] flex items-center justify-center shrink-0 overflow-hidden bg-white';
                ball.style.setProperty('--rot', `${rot}deg`);
                ball.style.animationDelay = `${delay}s`;
                ball.innerHTML = getOdungCapsuleSvg(false);
                container.appendChild(ball);
            }
        }

        async function startClawSequence(isInstant = false) {
            if (isAnimating) return;

            const eligible = getEligibleStudents();
            if (eligible.length === 0) {
                showToast('뽑을 수 있는 학생이 없습니다! 초기화 또는 출석을 확인해 주세요.');
                return;
            }

            const actualCount = Math.min(drawCount, eligible.length);
            if (actualCount < drawCount) {
                showToast(`남은 인원이 ${actualCount}명뿐이라 ${actualCount}명만 뽑습니다!`);
            }

            isAnimating = true;
            const startBtn = document.getElementById('start-claw-btn');
            const instantBtn = document.getElementById('instant-claw-btn');
            const windowBox = document.getElementById('claw-window-box');
            const statusText = document.getElementById('machine-status-text');
            const progressBadge = document.getElementById('turn-progress-badge');

            startBtn.disabled = true;
            instantBtn.disabled = true;
            startBtn.classList.add('opacity-50', 'cursor-not-allowed');
            instantBtn.classList.add('opacity-50', 'cursor-not-allowed');
            statusText.textContent = isInstant ? 'INSTANT CATCH!' : 'CATCHING...';
            progressBadge.textContent = `0 / ${actualCount} 진행 중`;

            // 다수 인원(3명 이상)이거나 한 번에 뽑기 시 고속 애니메이션 클래스 적용
            const isFast = isInstant || actualCount >= 3;
            if (isFast) {
                windowBox.classList.add('crane-fast');
            } else {
                windowBox.classList.remove('crane-fast');
            }

            const winnersBox = document.getElementById('current-winners-box');
            winnersBox.innerHTML = `
                <div class="col-span-2 my-auto flex flex-col items-center justify-center py-20 text-center">
                    <span class="text-3xl animate-bounce mb-2">🤫</span>
                    <p class="text-xs sm:text-sm font-bold text-amber-300 leading-relaxed">캡슐을 모두 뽑은 뒤<br>한 번에 공개됩니다!</p>
                    <p id="secret-progress-text" class="text-xs text-slate-400 mt-2">0 / ${actualCount}개 확보 중...</p>
                </div>
            `;

            const carriage = document.getElementById('crane-carriage');
            const cable = document.getElementById('crane-cable');
            const clawHead = document.getElementById('claw-head');
            const grabbedCapsule = document.getElementById('grabbed-capsule');
            document.getElementById('grabbed-capsule-inner').innerHTML = getOdungCapsuleSvg(true);
            const noRepeat = document.getElementById('no-repeat-checkbox').checked;

            const turnWinners = [];

            if (isInstant) {
                // [한 번에 뽑기] N명을 미리 추첨한 뒤 집게가 1회만 왕복하며 한꺼번에 투하
                for (let i = 0; i < actualCount; i++) {
                    const currentPool = getEligibleStudents();
                    if (currentPool.length === 0) break;
                    const chosen = currentPool[Math.floor(Math.random() * currentPool.length)];
                    turnWinners.push(chosen);
                    if (noRepeat) {
                        chosen.picked = true;
                    }
                }
                saveState();

                carriage.style.left = '55%';
                clawHead.classList.remove('claw-closed');
                clawHead.classList.add('claw-open');
                sfxMove();
                await sleep(160);

                cable.style.height = '185px';
                sfxDrop();
                await sleep(150);

                clawHead.classList.remove('claw-open');
                clawHead.classList.add('claw-closed');
                grabbedCapsule.classList.remove('hidden');
                sfxCatch();

                if (noRepeat) {
                    const rem = getEligibleStudents().length;
                    document.getElementById('machine-ball-count').textContent = rem;
                    renderDollPile(rem);
                }
                await sleep(120);

                cable.style.height = '22px';
                await sleep(150);

                carriage.style.left = '14%';
                sfxMove();
                await sleep(160);

                clawHead.classList.remove('claw-closed');
                clawHead.classList.add('claw-open');
                grabbedCapsule.classList.add('hidden');
                document.getElementById('drop-counter-badge').textContent = `${turnWinners.length} / ${actualCount}`;
                await sleep(100);
            } else {
                // [뽑기 시작!] N번 왕복 애니메이션 (인원이 많을수록 더 빠르게 동작)
                const moveDelay = actualCount >= 6 ? 150 : (actualCount >= 3 ? 210 : 380);
                const dropDelay = actualCount >= 6 ? 140 : (actualCount >= 3 ? 190 : 350);
                const catchDelay = actualCount >= 6 ? 80 : (actualCount >= 3 ? 120 : 220);

                for (let i = 0; i < actualCount; i++) {
                    const currentPool = getEligibleStudents();
                    if (currentPool.length === 0) break;

                    const randIdx = Math.floor(Math.random() * currentPool.length);
                    const chosen = currentPool[randIdx];
                    turnWinners.push(chosen);

                    if (noRepeat) {
                        chosen.picked = true;
                        saveState();
                    }

                    // 1) 크레인 좌우 이동
                    const targetX = 32 + Math.floor(Math.random() * 54);
                    carriage.style.left = `${targetX}%`;
                    clawHead.classList.remove('claw-closed');
                    clawHead.classList.add('claw-open');
                    sfxMove();
                    await sleep(moveDelay);

                    // 2) 집게 하강
                    cable.style.height = '185px';
                    sfxDrop();
                    await sleep(dropDelay);

                    // 3) 집게 오므리기 및 캡슐 잡기 (유리창 속 공 개수 1개 차감)
                    clawHead.classList.remove('claw-open');
                    clawHead.classList.add('claw-closed');
                    grabbedCapsule.classList.remove('hidden');
                    sfxCatch();

                    if (noRepeat) {
                        const rem = getEligibleStudents().length;
                        document.getElementById('machine-ball-count').textContent = rem;
                        renderDollPile(rem);
                    }
                    await sleep(catchDelay);

                    // 4) 집게 상승
                    cable.style.height = '22px';
                    await sleep(dropDelay);

                    // 5) 배출구(DROP ZONE)로 이동 후 투하
                    carriage.style.left = '14%';
                    sfxMove();
                    await sleep(moveDelay);

                    clawHead.classList.remove('claw-closed');
                    clawHead.classList.add('claw-open');
                    grabbedCapsule.classList.add('hidden');

                    document.getElementById('drop-counter-badge').textContent = `${i + 1} / ${actualCount}`;
                    progressBadge.textContent = `${i + 1} / ${actualCount} 완료`;
                    const secretText = document.getElementById('secret-progress-text');
                    if (secretText) secretText.textContent = `${i + 1} / ${actualCount}개 확보 완료!`;

                    await sleep(catchDelay);
                }
            }

            // 크레인 원위치 복귀 & 당첨 결과 한 번에 공개
            carriage.style.left = '50%';
            windowBox.classList.remove('crane-fast');
            statusText.textContent = 'COMPLETE!';
            progressBadge.textContent = `총 ${turnWinners.length}명 당첨!`;

            const cardsHtml = turnWinners.map((w, idx) => `
                <div class="animate-pop-in px-2.5 py-2 bg-gradient-to-r from-amber-300 to-amber-400 text-[#121629] border-2 border-black shadow-[3px_3px_0px_#000] flex items-center gap-1.5 text-left" style="animation-delay: ${idx * 0.05}s;">
                    <span class="text-sm font-bold shrink-0">${getCircledNumber(idx + 1)}</span>
                    <span class="text-xs sm:text-sm font-bold truncate">${escapeHtml(w.name)}</span>
                </div>
            `).join('');

            winnersBox.innerHTML = cardsHtml;
            document.getElementById('modal-winners-list').innerHTML = turnWinners.map((w, idx) => `
                <div class="px-3 py-2.5 bg-gradient-to-r from-amber-300 to-orange-400 text-[#121629] border-[3px] border-black shadow-[4px_4px_0px_#000] flex items-center gap-2 text-left">
                    <span class="text-base sm:text-lg font-bold shrink-0">${getCircledNumber(idx + 1)}</span>
                    <span class="text-base sm:text-lg font-bold truncate">${escapeHtml(w.name)}</span>
                </div>
            `).join('');

            winnersBox.innerHTML = cardsHtml;
            document.getElementById('modal-winners-list').innerHTML = turnWinners.map((w, idx) => `
                <div class="w-full px-4 py-2.5 bg-gradient-to-r from-amber-300 to-orange-400 text-[#121629] border-[3px] border-black shadow-[4px_4px_0px_#000] flex items-center gap-2.5 text-left">
                    <span class="text-lg sm:text-xl font-bold shrink-0">${getCircledNumber(idx + 1)}</span>
                    <span class="text-lg sm:text-xl font-bold truncate">${escapeHtml(w.name)}</span>
                </div>
            `).join('');

            updateStatusUI();
            sfxFanfare();
            toggleModal('result-reveal-modal', true);

            isAnimating = false;
            startBtn.disabled = false;
            instantBtn.disabled = false;
            startBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            instantBtn.classList.remove('opacity-50', 'cursor-not-allowed');
            statusText.textContent = 'READY';
        }

        // --- 4. 출석/결석 및 중복 방지 상태 UI 관리 ---
        function handleOptionChange() {
            updateStatusUI();
        }

        function resetPickedHistory() {
            if (isAnimating) return;
            students.forEach(s => s.picked = false);
            saveState();
            updateStatusUI();
            showToast('이미 뽑힌 학생 기록이 초기화되었습니다!');
        }

        function toggleStudentAbsent(id) {
            if (isAnimating) return;
            const stu = students.find(s => s.id === id);
            if (!stu) return;
            stu.absent = !stu.absent;
            saveState();
            renderAttendanceGrid();
            updateStatusUI();
        }

        function setAllPresent() {
            if (isAnimating) return;
            students.forEach(s => s.absent = false);
            saveState();
            renderAttendanceGrid();
            updateStatusUI();
            showToast('전원 출석 상태로 변경되었습니다.');
        }

        function renderAttendanceGrid() {
            const grid = document.getElementById('attendance-grid');
            grid.innerHTML = '';

            students.forEach(stu => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => toggleStudentAbsent(stu.id);

                if (stu.absent) {
                    btn.className = 'px-1.5 py-2 bg-[#1a152e] border border-red-500/40 text-slate-500 line-through text-[11px] font-bold truncate cursor-pointer hover:border-red-400 transition-colors';
                    btn.title = `${stu.name} (결석 - 클릭 시 출석 처리)`;
                } else {
                    btn.className = 'px-1.5 py-2 bg-[#1e193b] border border-sky-400/50 text-white hover:border-amber-400 text-[11px] font-bold truncate cursor-pointer transition-colors';
                    btn.title = `${stu.name} (출석 - 클릭 시 결석 처리)`;
                }
                btn.textContent = stu.name;
                grid.appendChild(btn);
            });
        }

        function updateStatusUI() {
            const presentStudents = students.filter(s => !s.absent);
            const eligibleStudents = getEligibleStudents();
            const pickedStudents = students.filter(s => s.picked);

            document.getElementById('total-present-count').textContent = presentStudents.length;
            document.getElementById('remaining-count').textContent = eligibleStudents.length;
            document.getElementById('machine-ball-count').textContent = eligibleStudents.length;
            document.getElementById('group-present-count').textContent = presentStudents.length;

            renderDollPile(eligibleStudents.length);

            const historyBox = document.getElementById('picked-history-list');
            if (pickedStudents.length === 0) {
                historyBox.innerHTML = '<span class="text-xs text-slate-500">아직 뽑힌 학생이 없습니다.</span>';
            } else {
                historyBox.innerHTML = pickedStudents.map(s => `
                    <span class="px-2 py-0.5 bg-purple-500/20 border border-purple-400/60 text-purple-200 text-[11px] font-bold">
                        ${escapeHtml(s.name)}
                    </span>
                `).join('');
            }
        }

        // --- 5. 명단 등록/수정 모달 로직 ---
        function syncRosterTextarea() {
            document.getElementById('roster-textarea').value = students.map(s => s.name).join('\n');
        }

        function generateNumberRoster() {
            let count = parseInt(document.getElementById('auto-num-input').value, 10);
            if (isNaN(count) || count < 2) count = 2;
            if (count > 60) count = 60;
            const lines = Array.from({ length: count }, (_, i) => `${i + 1}번`);
            document.getElementById('roster-textarea').value = lines.join('\n');
        }

        function saveRosterFromTextarea() {
            const raw = document.getElementById('roster-textarea').value;
            const names = raw
                .split(/[\n,]+/)
                .map(n => n.trim())
                .filter(n => n.length > 0);

            if (names.length === 0) {
                showToast('최소 1명 이상의 이름을 입력해 주세요!');
                return;
            }

            students = names.map((name, idx) => ({
                id: 'stu_' + Date.now() + '_' + idx,
                name,
                absent: false,
                picked: false
            }));

            saveState();
            renderAttendanceGrid();
            updateStatusUI();
            toggleModal('roster-modal', false);
            showToast(`총 ${students.length}명의 명단이 저장되었습니다!`);
        }

        // --- 6. 모둠(조) 편성 로직 ---
        function generateGroups() {
            const present = students.filter(s => !s.absent);
            if (present.length < 2) {
                showToast('모둠을 나누려면 최소 2명 이상의 출석 학생이 필요합니다!');
                return;
            }

            const groupCount = parseInt(document.getElementById('group-count-select').value, 10);
            const shuffled = [...present];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }

            const groups = Array.from({ length: groupCount }, () => []);
            shuffled.forEach((stu, idx) => {
                groups[idx % groupCount].push(stu);
            });

            const grid = document.getElementById('groups-result-grid');
            const borderColors = [
                'border-[#4ade80]',
                'border-amber-400',
                'border-sky-400',
                'border-pink-400',
                'border-purple-400',
                'border-orange-400',
                'border-teal-400',
                'border-rose-400'
            ];

            grid.innerHTML = groups.map((members, idx) => {
                const bColor = borderColors[idx % borderColors.length];
                const memberTags = members.length > 0
                    ? members.map(m => `<li class="px-2.5 py-1.5 bg-[#120e24] border border-[#3b3363] text-white text-xs sm:text-sm font-bold">${escapeHtml(m.name)}</li>`).join('')
                    : `<li class="text-xs text-slate-500">배정 인원 없음</li>`;

                return `
                    <div class="animate-pop-in bg-[#16122e] border-[3px] ${bColor} p-3.5 flex flex-col" style="animation-delay: ${idx * 0.05}s;">
                        <div class="flex items-center justify-between border-b border-[#3b3363] pb-2 mb-2.5">
                            <span class="text-sm sm:text-base font-bold text-amber-300">${idx + 1}모둠</span>
                            <span class="text-xs text-slate-400 font-bold">${members.length}명</span>
                        </div>
                        <ul class="space-y-1.5">
                            ${memberTags}
                        </ul>
                    </div>
                `;
            }).join('');

            sfxFanfare();
        }

        // --- 7. 공용 모달, 토스트, 단축키 처리 ---
        function toggleModal(modalId, show) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            if (show) {
                if (modalId === 'roster-modal') syncRosterTextarea();
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        let toastTimer = null;
        function showToast(msg) {
            const toast = document.getElementById('toast-modal');
            document.getElementById('toast-message').textContent = msg;
            toast.classList.remove('hidden');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('hidden');
            }, 2600);
        }

        function escapeHtml(str) {
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        // 키보드 단축키 바인딩
        document.addEventListener('keydown', (e) => {
            const tag = document.activeElement.tagName;
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') return;

            const resultModal = document.getElementById('result-reveal-modal');
            const rosterModal = document.getElementById('roster-modal');
            const shortcutModal = document.getElementById('shortcut-modal');

            if (e.code === 'Escape') {
                toggleModal('result-reveal-modal', false);
                toggleModal('roster-modal', false);
                toggleModal('shortcut-modal', false);
                return;
            }

            if (e.code === 'Space') {
                e.preventDefault();
                if (!resultModal.classList.contains('hidden')) {
                    toggleModal('result-reveal-modal', false);
                    return;
                }
                if (rosterModal.classList.contains('hidden') && shortcutModal.classList.contains('hidden')) {
                    if (currentTab !== 'claw') switchMainTab('claw');
                    startClawSequence();
                }
                return;
            }

            if (['Digit1', 'Digit2', 'Digit3', 'Digit4', 'Digit5'].includes(e.code)) {
                const num = parseInt(e.code.replace('Digit', ''), 10);
                setDrawCount(num);
                showToast(`뽑을 인원: ${num}명 선택`);
                return;
            }

            if (e.code === 'KeyM') {
                toggleSound();
                return;
            }

            if (e.code === 'KeyR') {
                resetPickedHistory();
                return;
            }
        });

        // 앱 시작
        initApp();
    </script>
</body>
</html>
